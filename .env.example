# ---- Supabase (Project settings → API) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # server-only; used by ingestion and webhooks

# ---- LLM ----
ANTHROPIC_API_KEY=
LLM_MODEL_CHAT=                       # see docs/ARCHITECTURE.md for the current recommended model id
LLM_DAILY_SPEND_CAP_USD=20            # runtime refuses new calls past this

# ---- Embeddings ----
EMBEDDING_PROVIDER=voyage             # voyage | openai
VOYAGE_API_KEY=
OPENAI_API_KEY=                       # only if EMBEDDING_PROVIDER=openai

# ---- Payments ----
PAYMENTS_MODE=mock                    # mock | stripe. mock = "Hire" creates the purchase without Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
PLATFORM_FEE_PERCENT=20

# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
ADMIN_EMAILS=                         # comma-separated; these accounts get the admin nav
