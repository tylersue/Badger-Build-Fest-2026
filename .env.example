# The Phase 1 MVP is frontend only: it reads none of these yet.
# They are the variables later phases add when the backend lands.

# ---- Supabase (Project settings → API) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # server-only; never prefix with NEXT_PUBLIC_

# ---- LLM ----
ANTHROPIC_API_KEY=
LLM_DAILY_SPEND_CAP_USD=20            # runtime refuses new calls past this

# ---- Embeddings ----
EMBEDDING_PROVIDER=voyage             # voyage | openai
VOYAGE_API_KEY=
OPENAI_API_KEY=                       # only if EMBEDDING_PROVIDER=openai

# ---- Credits ----
PLATFORM_FEE_PERCENT=15               # platform share of the usage margin (lib/config/credits.ts)

# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
