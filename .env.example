# Server-only configuration. Copy names into .env.local; never commit credentials.
# Required for database access (Project Settings > API):
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Required for answers, web search, and embeddings:
OPENAI_API_KEY=

# Optional policy. Blank entries use the documented defaults below.
# Daily cap is exact decimal USD; default 20. Zero disables paid dispatch.
LLM_DAILY_SPEND_CAP_USD=
# Default 2026-09-26-standard-v1; standard published usage rates, not invoice-exact.
LLM_PRICE_VERSION=
# Only standard is accepted until a verified account discount policy is implemented.
LLM_PRICE_POLICY=
# Default career_admissions until supported by evidence or explicitly selected.
DEFAULT_AGENT_CATEGORY=

# Source defaults: 10 sources, 5 MiB/file, 25 MiB/agent, 100 PDF pages,
# 100000 extracted characters, 1000 active chunks including interview answers.
SOURCE_MAX_COUNT=
SOURCE_MAX_FILE_BYTES=
SOURCE_MAX_AGENT_BYTES=
SOURCE_MAX_PDF_PAGES=
SOURCE_MAX_EXTRACTED_CHARS=
SOURCE_MAX_ACTIVE_CHUNKS=
# Chunk target 2000 chars / overlap 200 chars (overlap must be below target).
SOURCE_CHUNK_TARGET_CHARS=
SOURCE_CHUNK_OVERLAP_CHARS=
# Parser: 15000 ms, 128 MiB worker heap, 20 MiB cumulative inflated DOCX bytes.
SOURCE_PARSER_TIMEOUT_MS=
SOURCE_PARSER_HEAP_MB=
SOURCE_MAX_DOCX_INFLATED_BYTES=

# Provider defaults: 100000 input chars, 20 history messages, 4096 output tokens,
# 30000 ms timeout, 200000-token maximum context envelope, 3 continuations.
# Context envelope must include provider tool/binary exposure before reservation.
LLM_MAX_INPUT_CHARS=
LLM_MAX_HISTORY_MESSAGES=
LLM_MAX_OUTPUT_TOKENS=
LLM_TIMEOUT_MS=
LLM_MAX_CONTEXT_TOKENS=
LLM_MAX_CONTINUATIONS=
# Web defaults/maxima: 1 search, 2 fetches, 1200 output tokens.
WEB_MAX_SEARCHES=
WEB_MAX_FETCHES=
WEB_MAX_OUTPUT_TOKENS=
# Default 4000 nominal content tokens; not a hard input bound for billing.
WEB_FETCH_CONTENT_TOKENS=
# Optional comma-separated domain names; configure at most one list.
# Applies to provider-managed tools; the application never fetches arbitrary URLs.
WEB_ALLOWED_DOMAINS=
WEB_BLOCKED_DOMAINS=
