{
  "name": "badger-experts",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "check:phase2-env": "node --experimental-strip-types scripts/check-phase2-env.ts",
    "test:phase2-live": "RUN_LIVE_TESTS=1 vitest run tests/integration/billing.live.test.ts tests/integration/intake.live.test.ts tests/integration/retrieval.live.test.ts --no-file-parallelism && node --experimental-strip-types scripts/phase2-live.ts",
    "test:phase3-sql": "RUN_LIVE_TESTS=1 vitest run tests/integration/phase3.live.test.ts --no-file-parallelism"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.65",
    "@ai-sdk/openai": "^4.0.78",
    "@supabase/supabase-js": "2.117.2",
    "ai": "7.0.116",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.48.0",
    "mammoth": "1.13.0",
    "next": "16.3.6",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "6.3.289",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "thinking-orbs": "0.3.2",
    "tw-animate-css": "^1.4.0",
    "unpdf": "1.8.1",
    "zod": "4.6.5"
  },
